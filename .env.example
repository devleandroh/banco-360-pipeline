# Copie para .env e preencha. Nunca versione o .env.

# Data Warehouse (Supabase → Project Settings → Database → Connection string → Session pooler)
# Sem esta variável, o docker compose usa o Postgres local (warehouse-db).
WAREHOUSE_DB_URL=

# Data Lake no Supabase Storage via protocolo S3 (Storage → S3 Connection / S3 Access Keys)
# Para usar AWS S3 de verdade: deixe LAKE_S3_ENDPOINT vazio e use credenciais IAM.
LAKE_S3_ENDPOINT=
LAKE_S3_REGION=
LAKE_S3_BUCKET=banco-360-lake
LAKE_S3_ACCESS_KEY_ID=
LAKE_S3_SECRET_ACCESS_KEY=

# Sal secreto do hash de CPF (LGPD). Gere um valor aleatório longo.
PII_SALT=
